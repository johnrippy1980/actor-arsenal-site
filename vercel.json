{
  "rewrites": [
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/api-docs", "destination": "/api-docs.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
